pipeline {
    agent any
    
    environment {
        AWS_REGION = 'ap-southeast-1'
        AWS_ACCOUNT_ID = credentials('aws-account-id')
        EKS_CLUSTER = 'my-app-staging-eks'
        KUBECONFIG = '/tmp/kubeconfig'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Get ECR URLs') {
            steps {
                script {
                    dir('infra/terraform/environments/staging') {
                        env.BACKEND_ECR = sh(
                            script: 'terraform output -raw backend_ecr_url',
                            returnStdout: true
                        ).trim()
                        env.FRONTEND_ECR = sh(
                            script: 'terraform output -raw frontend_ecr_url',
                            returnStdout: true
                        ).trim()
                    }
                }
            }
        }
        
        stage('Login to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                '''
            }
        }
        
        stage('Build Images') {
            parallel {
                stage('Build Backend') {
                    steps {
                        dir('backend') {
                            sh '''
                                docker build -t backend:${BUILD_NUMBER} .
                                docker tag backend:${BUILD_NUMBER} ${BACKEND_ECR}:${BUILD_NUMBER}
                                docker tag backend:${BUILD_NUMBER} ${BACKEND_ECR}:latest
                            '''
                        }
                    }
                }
                stage('Build Frontend') {
                    steps {
                        dir('frontend') {
                            sh '''
                                docker build -t frontend:${BUILD_NUMBER} .
                                docker tag frontend:${BUILD_NUMBER} ${FRONTEND_ECR}:${BUILD_NUMBER}
                                docker tag frontend:${BUILD_NUMBER} ${FRONTEND_ECR}:latest
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Push to ECR') {
            parallel {
                stage('Push Backend')
                stage('Push Backend') {
                    steps {
                        sh '''
                            docker push ${BACKEND_ECR}:${BUILD_NUMBER}
                            docker push ${BACKEND_ECR}:latest
                        '''
                    }
                }
                stage('Push Frontend') {
                    steps {
                        sh '''
                            docker push ${FRONTEND_ECR}:${BUILD_NUMBER}
                            docker push ${FRONTEND_ECR}:latest
                        '''
                    }
                }
            }
        }
        
        stage('Deploy to Staging') {
            steps {
                sh '''
                    # Configure kubectl
                    aws eks update-kubeconfig --name ${EKS_CLUSTER} --region ${AWS_REGION}
                    
                    # Update backend
                    kubectl set image deployment/backend \
                        backend=${BACKEND_ECR}:${BUILD_NUMBER} \
                        -n staging
                    
                    # Update frontend
                    kubectl set image deployment/frontend \
                        frontend=${FRONTEND_ECR}:${BUILD_NUMBER} \
                        -n staging
                    
                    # Wait for rollout
                    kubectl rollout status deployment/backend -n staging --timeout=5m
                    kubectl rollout status deployment/frontend -n staging --timeout=5m
                '''
            }
        }
        
        stage('Verify Deployment') {
            steps {
                sh '''
                    # Check pods
                    kubectl get pods -n staging
                    
                    # Get service URLs
                    echo "Backend URL:"
                    kubectl get svc backend-service -n staging -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'
                    
                    echo "\nFrontend URL:"
                    kubectl get svc frontend-service -n staging -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'
                '''
            }
        }
    }
    
    post {
        success {
            echo " Deployment successful! Build #${BUILD_NUMBER}"
        }
        failure {
            echo " Deployment failed! Build #${BUILD_NUMBER}"
        }
        always {
            sh 'docker system prune -f'
        }
    }
}